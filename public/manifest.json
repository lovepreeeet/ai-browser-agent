{
  "manifest_version": 3,
  "name": "AI Browser Agent",
  "version": "0.1.0",
  "description": "An AI agent that operates web pages through controlled, permission-gated tools.",
  "action": { "default_title": "Open AI Browser Agent" },
  "side_panel": { "default_path": "sidepanel.html" },
  "background": { "service_worker": "background.js" },
  "permissions": ["sidePanel", "scripting", "tabs", "storage"],
  "host_permissions": ["<all_urls>"]
}
